# FormulaFix environment variables.
# Copy to .env.local and fill in what you need: cp .env.example .env.local
# Keys are commented out, so a plain copy starts in demo mode:
# the rule-based analyzer, no sign-in, no payments.

# --- LLM: set ONE provider ------------------------------------------------
# LLM_PROVIDER forces a provider: anthropic | compat | hf | demo.
# Without it: ANTHROPIC_API_KEY -> anthropic, LLM_BASE_URL + LLM_API_KEY -> compat,
# HF_TOKEN -> hf, otherwise demo.
# LLM_PROVIDER=compat

# Option 1: Anthropic (https://console.anthropic.com -> API Keys)
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
# LLM_MODEL=claude-haiku-4-5-20251001

# Option 2: any OpenAI-compatible API (Groq, OpenRouter, Gemini's OpenAI endpoint).
# The live demo runs on Groq (https://console.groq.com/keys).
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_xxxxxxxx
# LLM_COMPAT_MODEL=openai/gpt-oss-120b

# Option 3: Hugging Face Inference Providers (https://huggingface.co/settings/tokens, Read is enough)
# HF_TOKEN=hf_xxxxxxxx
# HF_MODEL=Qwen/Qwen2.5-Coder-32B-Instruct

# --- Site -------------------------------------------------------------------
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --- Supabase: magic-link sign-in and quotas in the database (optional) ----
# 1. Create a project at https://supabase.com
# 2. SQL Editor: run supabase/migration.sql
# 3. Authentication -> URL Configuration: add {NEXT_PUBLIC_BASE_URL}/auth/callback to Redirect URLs
# 4. Keys: Project Settings -> API
# NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxx
# Server only, never expose it to the browser:
# SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxx

# --- Stripe: the Pro plan (optional) ---------------------------------------
# STRIPE_SECRET_KEY=sk_test_xxxxxxxx
# STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx
# STRIPE_PRICE_PRO_MONTHLY=price_xxxxxxxx

# --- Testing ----------------------------------------------------------------
# TEST_MODE=1 bypasses the quota for scripts/run-testset.mjs. Never set it in production.
# TEST_MODE=1
