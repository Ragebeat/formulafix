# ── FormulaFix — переменные окружения ─────────────────────────
# Скопируй в .env.local и заполни:  cp .env.example .env.local
# Без ключей приложение работает в демо-режиме
# (rule-based разборщик, без авторизации, email — в файл).

# ── LLM: два входа — Anthropic (прод) и Hugging Face (тест) ──
# Выбор провайдера (опционально): anthropic | hf | demo
# Без этой переменной: есть ANTHROPIC_API_KEY → anthropic,
# иначе есть HF_TOKEN → hf, иначе demo.
# LLM_PROVIDER=hf

# Вариант 1: Anthropic — основной для прода
# Ключ: https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxx
LLM_MODEL=claude-haiku-4-5-20251001

# Вариант 2: Hugging Face Inference Providers — бесплатно для тестов
# Токен: https://huggingface.co/settings/tokens (Read достаточно)
# Free-аккаунт даёт небольшие месячные кредиты; PRO $9/мес — 2M кредитов
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxx
# Модель (опционально). Кодовая Qwen хорошо держит JSON:
HF_MODEL=Qwen/Qwen2.5-Coder-32B-Instruct

# ── Сайт ───────────────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ── Supabase (авторизация magic link + квоты в БД) ────────────
# 1. Создай проект на https://supabase.com (бесплатный тир)
# 2. SQL Editor → выполни supabase/migration.sql
# 3. Authentication → URL Configuration → добавь
#    {NEXT_PUBLIC_BASE_URL}/auth/callback в Redirect URLs
# 4. Ключи: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxx
# service_role — ТОЛЬКО на сервере, никогда не коммитить:
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxx

# ── Stripe (добавить при подключении оплаты, раздел 5.4 ТЗ) ───
# STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxx
# STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxx
# STRIPE_PRICE_PRO_MONTHLY=price_xxxxxxxxxxxxxxxx
# STRIPE_PRICE_PRO_YEARLY=price_xxxxxxxxxxxxxxxx

# ── Аналитика (опционально) ───────────────────────────────────
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=formulafix.io

# ── Вариант 3: любой OpenAI-совместимый API (Groq, Gemini, OpenRouter) ──
# Groq — щедрый бесплатный тир (~1000 запросов/день):
# 1. Ключ: https://console.groq.com/keys
# 2. Раскомментируй и заполни:
# LLM_PROVIDER=compat
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_xxxxxxxxxxxxxxxx
# LLM_COMPAT_MODEL=llama-3.3-70b-versatile
